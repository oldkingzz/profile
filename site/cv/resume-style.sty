\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{resume-style}[2026/08/19 Vincent Wang resume style]

\RequirePackage[a4paper,top=0.44in,bottom=0.42in,left=0.52in,right=0.52in]{geometry}
\RequirePackage{fontspec}
\RequirePackage{xcolor}
\RequirePackage{hyperref}
\RequirePackage{enumitem}
\RequirePackage{tabularx}
\RequirePackage{array}

\definecolor{Accent}{HTML}{145B66}
\definecolor{Body}{HTML}{182126}
\definecolor{Muted}{HTML}{526068}
\definecolor{Rule}{HTML}{A8B8BC}

\hypersetup{
  colorlinks=true,
  urlcolor=Accent,
  linkcolor=Accent,
  pdfborder={0 0 0}
}

\pagestyle{empty}
\setlength{\parindent}{0pt}
\setlength{\parskip}{0pt}
\setlength{\tabcolsep}{0pt}
\setlength{\emergencystretch}{2em}
\color{Body}

\newcommand{\cvname}[1]{%
  {\fontsize{22}{24}\selectfont\bfseries\color{Body}#1\par}%
}

\newcommand{\cvtagline}[1]{%
  \vspace{1pt}{\fontsize{10.2}{12}\selectfont\color{Accent}\bfseries #1\par}%
}

\newcommand{\cvcontact}[1]{%
  \vspace{3pt}{\fontsize{9}{10.7}\selectfont\color{Muted}#1\par}%
  \vspace{3.4pt}\color{Rule}\hrule height 0.8pt\color{Body}
}

\newcommand{\cvsection}[1]{%
  \vspace{6.2pt}%
  {\fontsize{10.6}{12}\selectfont\bfseries\color{Accent}\MakeUppercase{#1}}%
  \hspace{0.55em}\color{Rule}\leaders\hrule height 0.45pt\hfill\kern0pt%
  \par\vspace{2.9pt}\color{Body}%
}

\newcommand{\cventry}[3]{%
  \begin{tabularx}{\linewidth}{@{}>{\raggedright\arraybackslash}X>{\raggedleft\arraybackslash}p{0.25\linewidth}@{}}
    {\fontsize{9.7}{11.4}\selectfont\bfseries #1} & {\fontsize{9.1}{10.8}\selectfont\bfseries\color{Muted}#2} \\
    \multicolumn{2}{@{}l@{}}{{\fontsize{9.1}{10.7}\selectfont\color{Muted}#3}}
  \end{tabularx}%
  \vspace{-1.5pt}%
}

\newcommand{\cvcompactentry}[2]{%
  \begin{tabularx}{\linewidth}{@{}>{\raggedright\arraybackslash}X>{\raggedleft\arraybackslash}p{0.25\linewidth}@{}}
    {\fontsize{9.6}{11.3}\selectfont\bfseries #1} & {\fontsize{9.1}{10.8}\selectfont\bfseries\color{Muted}#2}
  \end{tabularx}%
  \vspace{-1.5pt}%
}

\newenvironment{cvitems}{%
  \begin{itemize}[leftmargin=1.12em,label=\raisebox{0.18ex}{\tiny\textbullet},itemsep=1pt,topsep=2.1pt,parsep=0pt,partopsep=0pt]
  \fontsize{9.05}{10.85}\selectfont
}{%
  \end{itemize}\vspace{2.1pt}
}

\newcommand{\cvskill}[2]{%
  {\fontsize{9.05}{10.85}\selectfont\textbf{#1:} #2\par}%
  \vspace{0.9pt}%
}

\endinput
